# Copy to .env and fill in. Never commit the real .env — it holds the
# session string, which is equivalent to your Telegram login.

# From https://my.telegram.org/apps (create an app once; these two are not secret
# in the same way the session string is, but still keep them out of version control).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Produced once by `npm run login` (see README.md). Equivalent to being logged
# in as your Telegram account forever — treat it like a password, not a token.
TELEGRAM_SESSION_STRING=

# The n8n "Telegram MTProto In" webhook node's Production URL, e.g.
# https://your-n8n-host/webhook/telegram-mtproto-in
N8N_WEBHOOK_URL=

# Must match the Header Auth credential's value bound to that webhook node
# ("Tradosphere Signal Worker Secret", header name X-Signal-Worker-Secret).
WEBHOOK_SECRET=

# Comma-separated chat IDs to listen to. Defaults to the 5 SMC channels if unset
# (see src/index.ts DEFAULT_CHAT_IDS) — override only if the source list changes.
# TELEGRAM_CHAT_IDS=-1002902210804,-1002766156703,-1002739828902,-1002899616041,-1002670661233
