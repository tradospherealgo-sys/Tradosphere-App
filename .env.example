# ============================================================================
# Tradosphere Wealth Management — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local. NEVER put secret keys behind NEXT_PUBLIC_.
# ============================================================================

# --- Supabase (required) ---
# Project URL and anon key are public-safe (RLS protects data).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key: SERVER-SIDE ONLY. Used in API routes / server actions
# for admin operations (role changes, provider secret storage). Never
# reference this with NEXT_PUBLIC_ and never import the admin client from
# a "use client" file.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Google OAuth (for Supabase Auth "Sign in with Google") ---
# These are configured inside the Supabase Dashboard → Authentication →
# Providers → Google, NOT read directly by this app. Listed here so the
# person wiring up the project has one place that documents what's needed.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Market data providers (all optional at first boot) ---
# The app ships with NO provider enabled by default — Market Intelligence
# and Option Chain will show an explicit "not configured" state until an
# admin enables one from Admin → Market Data and the corresponding secret
# (if any) is present here. Provider selection itself is stored in the
# `integration_configs` table, not in env vars, so it can change without a
# redeploy — but any provider that requires a paid API key needs that key
# supplied server-side via an env var referenced below.

# --- Upstox (official market-data API — primary candidate provider) ---
# Powers the market-data integration only (Upstox's option-chain endpoint is
# not wired into the option-chain provider abstraction yet).
#
# 1. Create an app at https://account.upstox.com/developer/apps to get a
#    client_id / client_secret and register a redirect_uri.
# 2. Complete the OAuth authorize/login flow once (GET /v2/login/authorization/
#    dialog, then POST /v2/login/authorization/token) to mint an access_token.
# 3. Set it below. The env var name is whatever you type into the "Secret env
#    var name" field on the integration card (default UPSTOX_ACCESS_TOKEN).
#
# IMPORTANT: Upstox access tokens expire daily at 3:30 AM IST and there is no
# refresh token — a human must repeat step 2 and update this value every day
# the feed is in use. This is an Upstox platform constraint, not something
# the app can automate away.
#
# Quotes are looked up by Upstox `instrument_key` (e.g. "NSE_EQ|INE002A01018"),
# not by trading symbol. Populate `instruments.provider_token` per symbol from
# Upstox's published instrument master, or set config.instrumentKeys on the
# integration row as an explicit override, before quotes will resolve.
UPSTOX_ACCESS_TOKEN=

# --- SMC Global (the intended production feed) ---
# Powers BOTH the market-data and option-chain integrations. Enabling both
# in Admin → Integrations opens ONE upstream session, not two.
#
# Obtain these from SMC's API partner onboarding — there is no public
# self-service signup, and the app will not fabricate prices in their
# absence: every surface renders an explicit "no provider configured" state
# until a real quote comes back.
#
# The prefix (`SMC` below) is whatever you type into the "Secret env var
# name" field on the integration card, so you can run two SMC connections
# side by side by using a second prefix.
SMC_API_KEY=
SMC_CLIENT_CODE=
SMC_API_SECRET=
# Only if your SMC account enforces 2FA:
SMC_TOTP_SECRET=

# Reference connector: unofficial NSE India public endpoints (no key
# required, real data, best-effort — NSE rate-limits and occasionally
# blocks server IPs; treat as a development-grade connector only).
# No env var needed.

# Optional: a generic REST provider an admin can point at any vendor
# (Upstox / Angel One market-data-only endpoints / Alpha Vantage / Twelve
# Data / a licensed NSE data vendor) that exposes quote/history/option
# chain JSON. Configure the base URL from Admin → Market Data; the key
# stays server-side here.
MARKET_DATA_GENERIC_API_KEY=
MARKET_DATA_GENERIC_BASE_URL=

# --- NSE session calendar (optional) ---
# The published NSE equity-segment trading holidays are compiled in. Set this
# to a comma-separated list of YYYY-MM-DD dates to override them when the
# exchange announces a change mid-year, so an added holiday or a special
# session does not need a redeploy. Leave unset to use the built-in list.
# NSE_TRADING_HOLIDAYS=2026-01-26,2026-02-15

# --- Automated tests only — NEVER set in production ---
# Arms a deterministic price source so the E2E suite has something to fill
# orders against without a market feed. It is deliberately hard to switch
# on: the provider is ALSO gated on an admin selecting `test_fixture` in
# integration_configs, and it is absent from the admin UI. With either half
# missing the app falls back to "no provider configured" rather than
# inventing prices. Format is a JSON symbol→price map.
# MARKET_DATA_TEST_FIXTURE={"TESTCO":1000}
#
# The seeded E2E tier — scripts/e2e-local.sh sets all of these for you.
# E2E_TEST_EMAIL/PASSWORD must name a disposable auth user, never a real or
# admin account: global setup deletes and recreates it on every run.
# E2E_SEED=1
# E2E_TEST_EMAIL=e2e-lifecycle@test.invalid
# E2E_TEST_PASSWORD=
# E2E_BASE_URL=http://localhost:3100

# --- Telegram signal ingestion (optional) ---
# Feeds SMC / trusted-channel calls into the Signal Desk. Both variables are
# required together; without TELEGRAM_WEBHOOK_SECRET the webhook route
# refuses every request with 503 rather than accepting anonymous posts.
#
# 1. Create a bot with @BotFather → gives you the bot token.
# 2. Choose any long random string for the webhook secret.
# 3. Register the webhook (Telegram echoes the secret back on every
#    delivery in the X-Telegram-Bot-Api-Secret-Token header, which is the
#    only authentication the Bot API offers):
#
#      curl -F "url=https://YOUR_HOST/api/telegram/webhook" \
#           -F "secret_token=$TELEGRAM_WEBHOOK_SECRET" \
#           "https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/setWebhook"
#
# 4. Add the bot to the channel, then register that channel's chat id as a
#    signal source in Admin → Signal Desk. Messages from a chat that is not
#    registered are stored verbatim and marked "ignored" — never published.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- Scheduled jobs (optional but recommended) ---
# Shared secret for the maintenance endpoints under /api/cron/*. Send it as
# "Authorization: Bearer $CRON_SECRET". Without it those routes return 503
# rather than running unauthenticated.
#
#   curl -X POST -H "Authorization: Bearer $CRON_SECRET" \
#        https://YOUR_HOST/api/cron/expire-subscriptions
#
# Daily is sufficient. Entitlement checks compare the period end against
# now() on every read, so a missed run delays the expiry notification but
# never leaves a lapsed subscriber with access.
CRON_SECRET=

# --- Payment gateway (not yet wired) ---
# No gateway is integrated. Checkout opens a *pending* payment row and grants
# nothing; only a signature-verified gateway webhook calling the service-role
# function record_payment_success() can activate a subscription. Until then
# the sanctioned way to give access is Admin → Subscriptions → Grant access,
# which is recorded as source = 'admin_grant' so comped and paid access are
# never confused in reporting.
#
# To integrate one (Razorpay / Stripe / PayU), add its credentials here and
# a route that verifies the signature before calling record_payment_success.
# REQUIRED CREDENTIALS (choose one gateway):
#   RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET / RAZORPAY_WEBHOOK_SECRET
#   STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET
